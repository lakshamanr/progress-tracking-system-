@model DailyPlan
@{
    ViewData["Title"] = "Today's Plan";
}

<div class="row mb-4">
    <div class="col">
        <h1 class="display-5">
            <i class="bi bi-calendar-day text-primary"></i> Today's Plan
        </h1>
        <p class="lead">@DateTime.Today.ToString("dddd, MMMM d, yyyy")</p>
    </div>
</div>

@if (Model == null)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle"></i> @ViewBag.ErrorMessage
    </div>
}
else
{
    <div class="row">
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Day @Model.DayNumber: @Model.Title</h5>
                </div>
                <div class="card-body">
                    <form asp-controller="Progress" asp-action="UpdateToday" method="post">
                        <input type="hidden" name="planId" value="@Model.Id" />

                        <!-- Activities -->
                        <div class="mb-4">
                            <h6 class="border-bottom pb-2">Activities</h6>

                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" name="morningCompleted"
                                       id="morningCompleted" @(Model.Progress?.MorningCompleted == true ? "checked" : "")>
                                <label class="form-check-label" for="morningCompleted">
                                    <strong><i class="bi bi-sun"></i> Morning:</strong> @Model.MorningActivity
                                </label>
                            </div>

                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" name="eveningCompleted"
                                       id="eveningCompleted" @(Model.Progress?.EveningCompleted == true ? "checked" : "")>
                                <label class="form-check-label" for="eveningCompleted">
                                    <strong><i class="bi bi-sunset"></i> Evening:</strong> @Model.EveningActivity
                                </label>
                            </div>

                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" name="nightCompleted"
                                       id="nightCompleted" @(Model.Progress?.NightCompleted == true ? "checked" : "")>
                                <label class="form-check-label" for="nightCompleted">
                                    <strong><i class="bi bi-moon"></i> Night:</strong> @Model.NightActivity
                                </label>
                            </div>
                        </div>

                        <!-- Metrics -->
                        <div class="mb-4">
                            <h6 class="border-bottom pb-2">Metrics</h6>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="dsaProblems" class="form-label">
                                        <i class="bi bi-code-square"></i> DSA Problems Completed
                                    </label>
                                    <input type="number" class="form-control" id="dsaProblems" name="dsaProblems"
                                           value="@(Model.Progress?.DsaProblemsCompleted ?? 0)" min="0">
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="hoursSpent" class="form-label">
                                        <i class="bi bi-clock"></i> Hours Spent
                                    </label>
                                    <input type="number" class="form-control" id="hoursSpent" name="hoursSpent"
                                           value="@(Model.Progress?.HoursSpent ?? 0)" min="0" max="24" step="0.5">
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="energyLevel" class="form-label">
                                        <i class="bi bi-battery-charging"></i> Energy Level (1-5)
                                    </label>
                                    <input type="range" class="form-range" id="energyLevel" name="energyLevel"
                                           value="@(Model.Progress?.EnergyLevel ?? 3)" min="1" max="5">
                                    <div class="text-center">
                                        <span id="energyLevelValue">@(Model.Progress?.EnergyLevel ?? 3)</span>/5
                                    </div>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label for="confidenceLevel" class="form-label">
                                        <i class="bi bi-graph-up-arrow"></i> Confidence Level (1-5)
                                    </label>
                                    <input type="range" class="form-range" id="confidenceLevel" name="confidenceLevel"
                                           value="@(Model.Progress?.ConfidenceLevel ?? 3)" min="1" max="5">
                                    <div class="text-center">
                                        <span id="confidenceLevelValue">@(Model.Progress?.ConfidenceLevel ?? 3)</span>/5
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Notes -->
                        <div class="mb-4">
                            <label for="notes" class="form-label">
                                <i class="bi bi-journal-text"></i> Notes
                            </label>
                            <textarea class="form-control" id="notes" name="notes" rows="4"
                                      placeholder="Add any notes, learnings, or reflections...">@(Model.Progress?.Notes ?? "")</textarea>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-save"></i> Save Progress
                            </button>
                            <button type="button" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#skipModal">
                                <i class="bi bi-skip-forward"></i> Skip Day
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0"><i class="bi bi-info-circle"></i> Day Information</h6>
                </div>
                <div class="card-body">
                    <p><strong>Day Number:</strong> @Model.DayNumber of 368</p>
                    <p><strong>Week:</strong> @Model.WeekNumber</p>
                    <p><strong>Month Theme:</strong> @Model.MonthTheme</p>
                    <p><strong>Focus Area:</strong> @Model.FocusArea</p>
                    <p><strong>Interview Prep:</strong> @Model.InterviewPrepTopic</p>
                </div>
            </div>

            @if (Model.Progress != null)
            {
                <div class="card">
                    <div class="card-header bg-success text-white">
                        <h6 class="mb-0"><i class="bi bi-check-circle"></i> Current Progress</h6>
                    </div>
                    <div class="card-body">
                        <div class="progress mb-3" style="height: 25px;">
                            <div class="progress-bar" role="progressbar"
                                 style="width: @Model.Progress.CompletionPercentage%"
                                 aria-valuenow="@Model.Progress.CompletionPercentage"
                                 aria-valuemin="0" aria-valuemax="100">
                                @Model.Progress.CompletionPercentage%
                            </div>
                        </div>
                        <ul class="list-unstyled">
                            <li>
                                <i class="bi @(Model.Progress.MorningCompleted ? "bi-check-circle-fill text-success" : "bi-circle")"></i>
                                Morning
                            </li>
                            <li>
                                <i class="bi @(Model.Progress.EveningCompleted ? "bi-check-circle-fill text-success" : "bi-circle")"></i>
                                Evening
                            </li>
                            <li>
                                <i class="bi @(Model.Progress.NightCompleted ? "bi-check-circle-fill text-success" : "bi-circle")"></i>
                                Night
                            </li>
                        </ul>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- Skip Day Modal -->
<div class="modal fade" id="skipModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Skip Today</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Progress" asp-action="Skip" method="post">
                <div class="modal-body">
                    <input type="hidden" name="planId" value="@Model?.Id" />

                    <div class="mb-3">
                        <label for="reason" class="form-label">Reason for skipping</label>
                        <textarea class="form-control" id="reason" name="reason" rows="3" required></textarea>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="autoReschedule"
                               id="autoReschedule" checked>
                        <label class="form-check-label" for="autoReschedule">
                            Automatically reschedule remaining days
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Skip Day</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Update energy level display
        document.getElementById('energyLevel').addEventListener('input', function() {
            document.getElementById('energyLevelValue').textContent = this.value;
        });

        // Update confidence level display
        document.getElementById('confidenceLevel').addEventListener('input', function() {
            document.getElementById('confidenceLevelValue').textContent = this.value;
        });
    </script>
}
