<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Daily Plan Tracker</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="main-container">
        <!-- Beautiful Gradient Header -->
        <header class="app-header fade-in">
            <h1>🎯 Daily Plan Tracker</h1>
            <p class="subtitle">368-Day Learning Journey | Track Your Progress to Success</p>
        </header>

        <!-- Modern Navigation Bar -->
        <nav class="navbar navbar-expand-lg navbar-dark" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 8px 0;">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door-fill"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="progressDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-graph-up-arrow"></i> Progress
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Progress" asp-action="Today"><i class="bi bi-calendar-day"></i> Today's Plan</a></li>
                                <li><a class="dropdown-item" asp-controller="Progress" asp-action="Week"><i class="bi bi-calendar-week"></i> This Week</a></li>
                                <li><a class="dropdown-item" asp-controller="Progress" asp-action="Month"><i class="bi bi-calendar-month"></i> This Month</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Progress" asp-action="Calendar"><i class="bi bi-calendar3"></i> Calendar View</a></li>
                                <li><a class="dropdown-item" asp-controller="Progress" asp-action="Stats"><i class="bi bi-bar-chart-fill"></i> Statistics</a></li>
                                <li><a class="dropdown-item" asp-controller="Progress" asp-action="Timeline"><i class="bi bi-clock-history"></i> Timeline</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="reportsDropdown" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-file-earmark-bar-graph"></i> Reports
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="Import"><i class="bi bi-file-earmark-arrow-down"></i> Import Plan</a></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="ImportProgress"><i class="bi bi-upload"></i> Import Progress CSV</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="Weekly"><i class="bi bi-journal-text"></i> Weekly Summary</a></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="Monthly"><i class="bi bi-calendar-month-fill"></i> Monthly Report</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="ExportExcel"><i class="bi bi-file-earmark-excel"></i> Export to Excel</a></li>
                                <li><a class="dropdown-item" asp-controller="Reports" asp-action="ExportCsv"><i class="bi bi-filetype-csv"></i> Export to CSV</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Content Wrapper --><div class="content-wrapper" style="padding: 20px;">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show scale-in" role="alert" style="border-radius: 10px; border-left: 4px solid #56ab2f; padding: 0.6rem 1rem;">
                    <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show scale-in" role="alert" style="border-radius: 10px; border-left: 4px solid #f5576c; padding: 0.6rem 1rem;">
                    <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["WarningMessage"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show scale-in" role="alert" style="border-radius: 10px; border-left: 4px solid #ffc107; padding: 0.6rem 1rem;">
                    <i class="bi bi-exclamation-circle-fill"></i> @TempData["WarningMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <main role="main" class="pb-2">
                @RenderBody()
            </main>
        </div>

        <!-- Modern Footer -->
        <footer style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 15px 30px; color: white; text-align: center; margin-top: 20px; border-radius: 0 0 15px 15px;">
            <div>
                <p style="margin: 0; font-size: 0.9rem; font-weight: 500;">
                    <i class="bi bi-calendar-check"></i> Daily Plan Tracker
                </p>
                <p style="margin: 3px 0 0 0; opacity: 0.9; font-size: 0.75rem;">
                    368 Days Learning Journey | © @DateTime.Now.Year - Track Progress, Achieve Goals
                </p>
            </div>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
